{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(logo%20kkn|slideshow|Humas|PDD|DPL|KSB|Acara|Perlengkapan|MP3|Galeri%20Dokumentasi|Sorotan%20Kegiatan|Kolaborasi%20Pemuda|MOMEN%20ACAK%20%26%20CANDID)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}